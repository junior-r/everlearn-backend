PORT=4000
DATABASE_URL=postgresql://everlearn:everlearn@localhost:5432/everlearn?schema=public
REDIS_URL=redis://localhost:6379

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_32_chars_minimum

# Shared secret the video-server uses to call the backend internal API
INTERNAL_SERVICE_SECRET=change_me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_SECRET=dev_access_secret_change_me_32_chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_32_chars_min
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Attempts allowed per client and per account on /auth/login and /auth/register
RATE_LIMIT_AUTH_MAX_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Private storage for uploaded ID photos (development only)
UPLOADS_DIR=./uploads

# First Platform Admin, created on start if no account has this email. Unset to disable.
PLATFORM_ADMIN_EMAIL=admin@everlearn.local
PLATFORM_ADMIN_PASSWORD=dev-platform-admin-password

# URL of the ocr-server microservice. Leave unset to use the built-in mock OCR.
# OCR_SERVICE_URL=http://localhost:8000
